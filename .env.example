# Copy to .env and fill in your key. .env is gitignored.
#
# Real environment variables win over this file, so you can override any of
# these for a single run:
#
#   OPENAI_MODEL=gpt-5.6-mini cinch

OPENAI_API_KEY=sk-your-key-here

# Optional. Defaults to gpt-5.6. CINCH_MODEL works too and wins if both are set.
OPENAI_MODEL=gpt-5.6

# Optional. "openai" (default) or "openai-compatible".
#
# Each provider looks for its own key variable first — OPENAI_API_KEY for
# openai, ANTHROPIC_API_KEY for anthropic — then falls back to CINCH_API_KEY.
# CINCH_PROVIDER=openai

# Required only for openai-compatible: the address of a service that implements
# the OpenAI Responses API. Note that is the Responses API specifically, not the
# older chat-completions format.
# CINCH_BASE_URL=

# Optional. Token count that triggers compaction, default 100000.
#
# Every turn re-sends the whole conversation, so a long session grows until it
# will not fit. Past this size cinch clears old tool output, and summarises the
# older half if clearing was not enough. Set it to 0 to disable both.
# CINCH_COMPACT_AT=100000

# Optional. How hard the model thinks before answering. One of none, minimal,
# low, medium, high, xhigh, max. Left unset, the API picks its own default.
#
# Not every model accepts every level, and a rejected level comes back as a 400
# listing the ones that model does take. Change it mid-session with /effort.
# CINCH_EFFORT=medium

# Optional. How bash commands are judged before they run.
#
#   policy  the default. Reading inside the workspace runs without asking,
#           a short list of catastrophic commands is refused outright, and
#           everything else asks.
#   strict  the same refusals, but asks about reads too.
#   off     no judgement: bash asks every time and nothing is refused.
#
# Only "confined" is a real boundary: it uses Landlock so the kernel refuses
# to let anything cinch starts leave the workspace, whatever you approve.
# It needs Linux 5.13 or newer, and cinch refuses to start without it rather
# than running unprotected.
#
# The other three catch accidents, not attacks. Anything you approve under
# them still runs with your full permissions.
# CINCH_SANDBOX=policy

# Optional. Set to anything to skip the full-screen interface and use the plain
# line prompt instead. The --no-tui flag does the same for a single run.
#
# cinch already falls back to the plain prompt when stdin is not a terminal, so
# pipes and CI do not need this.
# CINCH_NO_TUI=1
